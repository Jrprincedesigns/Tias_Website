# Shopify app credentials (Dev/Partner Dashboard → the app → API credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://spa.example.com
SHOPIFY_SHOP_DOMAIN=theetcollection.myshopify.com

# Signs app-proxy requests and webhooks. Same value as SHOPIFY_API_SECRET
# unless the app is configured otherwise.
SHOPIFY_WEBHOOK_SECRET=

# Supabase — the service role key is server-only. It must never reach the
# theme, a browser bundle, or a customer account extension.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
