# Shopify app credentials. `shopify app dev` writes most of these for you the
# first time it runs; copy them here only for a deployment.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://spa.example.com
SCOPES=read_customers,write_customers,write_products,read_own_subscription_contracts,write_own_subscription_contracts,write_draft_orders,read_orders

# Supabase Postgres. Sessions and every service table live here.
# Use the POOLER connection string (port 6543), not the direct one — serverless
# functions open far more connections than a direct Postgres accepts.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=3

# Supabase Storage, for wig photos. Required by /apps/spa/upload-url.
# The service role key bypasses row level security entirely — server
# environment only. It must never reach the theme, a browser bundle, or a
# customer account extension. Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
